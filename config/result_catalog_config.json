    {
      "id": "smoke-markers",
      "category": "smoke",
      "match": {
        "contains_any": [
          "/smoke/",
          "/_smoke",
          "/samp_smoke_none/",
          "/simple_kfold_smoke/",
          "/smoke_test/",
