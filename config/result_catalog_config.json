{
  "schema_version": 1,
  "scope": "Metadata inventory only; original artifacts stay in place. Rules are explicit research-scope decisions, not age-based invalidation.",
  "categories": {
    "current_core": {
      "label": "現行核心完成 run",
      "note": "已選定的固定年份 run 且 manifest completed；不代表全部 baseline 已完成。"
    },
    "current_extension": {
      "label": "現行擴充完成 run",
      "note": "已選定的完整滑動視窗 run，與核心 target 分開。"
    },
    "interim_snapshot": {
      "label": "部分 seeds／階段快照",
      "note": "沿用快照身份，不自動混入完成後的 seeds。"
    },
    "failed_run": {
      "label": "失敗 run",
      "note": "manifest 記錄 failed；保留診斷，不用作正式成效。"
    },
    "smoke": {
      "label": "試跑／smoke",
      "note": "有限設定或樣本；命名分類仍需核對其 metadata。"
    },
    "checkpoint_partial": {
      "label": "中途／恢復檔",
      "note": "只標記該檔，不能據此推論整個實驗失敗。"
    },
    "retired_scope": {
      "label": "已退出研究範圍",
      "note": "保留沿革；退出不代表方法無效。"
    },
    "oracle_exploration": {
      "label": "Test-selected／oracle 探索",
      "note": "Test 參與選擇或事後排名；不是無偏選擇證據。"
    },
    "historical_protocol": {
      "label": "歷史協定／匯出",
      "note": "不同切割、方法或檢定來源；按版本引用。"
    },
    "exploratory_extension": {
      "label": "其他擴充／探索",
      "note": "逐 run 核對來源；部分含已退出方法，不能整個目錄判廢。"
    },
    "auxiliary": {
      "label": "輔助資料／分析",
      "note": "跨領域與穩定性等獨立分析；適用範圍需交代。"
    },
    "audit_snapshot": {
      "label": "審查／provenance 快照",
      "note": "查核時點的證據，不代表當前所有檔案已涵蓋。"
    },
    "documentation": {
      "label": "人工導航",
      "note": "目錄使用說明。"
    },
    "needs_review": {
      "label": "待確認來源",
      "note": "缺少足夠規則或完成證據，未宣稱過時或有效。"
    }
  },
  "selected_runs": [
    {
      "id": "fixed_study12",
      "path": "results/phase2_ensemble/standard_dynamic/runs/20261004T202331745995Z",
